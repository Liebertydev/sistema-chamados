// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  TECHNICIAN
  ADMIN
}

enum StatusSolicitacaoTecnico {
  PENDENTE
  APROVADA
  REJEITADA
}

// Não criaremos uma nova entidade Technician, pois vamos evitar a duplicação de informações, porque de USER para TECHNICIAN só muda a responsabilidade.

model User {
  id       Int    @id @default(autoincrement())
  name     String
  email    String @unique
  password String

  cpf       String? @unique
  matricula String? @unique
  ocupacao  String

  departamentoId Int
  departamento   Departamento @relation(fields: [departamentoId], references: [id])

  role Role @default(USER) //OBS

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chamadosCriados   Chamado[] @relation("ChamadosCriados")
  chamadosAtendidos Chamado[] @relation("ChamadosAtendidos")

  solicitacoesTecnico SolicitacaoTecnico[]
}

model Departamento {
  id   Int    @id @default(autoincrement())
  nome String @unique
  ativo Boolean @default(true)

  chamados Chamado[]
  usuarios User[]
}

model Localizacao {
  id Int @id @default(autoincrement())

  nome    String
  setor   String
  detalhe String

  chamados Chamado[]
}

model SolicitacaoTecnico {
  id Int @id @default(autoincrement())

  userId Int
  user   User @relation(fields: [userId], references: [id])

  status StatusSolicitacaoTecnico @default(PENDENTE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// no model Chamado vamos usar o relacionamento 1:N
model Chamado {
  id               Int     @id @default(autoincrement())
  titulo           String
  descricao        String?
  categoria        String
  numeroPatrimonio Int
  equipamento      String

  userId Int //foreign key
  user   User @relation("ChamadosCriados", fields: [userId], references: [id])

  tecnicoId Int?
  tecnico   User? @relation("ChamadosAtendidos", fields: [tecnicoId], references: [id])

  departamentoId Int
  departamento   Departamento @relation(fields: [departamentoId], references: [id])

  localizacaoId Int
  localizacao   Localizacao @relation(fields: [localizacaoId], references: [id])

  status     StatusChamado     @default(ABERTO)
  prioridade PrioridadeChamado @default(MEDIA)

  dataPrevisaoResolucao DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum StatusChamado {
  ABERTO
  EM_ANDAMENTO
  RESOLVIDO
  FECHADO
}

enum PrioridadeChamado {
  BAIXA
  MEDIA
  ALTA
  URGENTE
}
